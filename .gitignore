# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# intercom-go build artifacts and local-only config (001.001.001-ST)
dist/
.env.*
config.toml

# Ephemeral SQLite databases (always regenerated; never commit)
backlogit.db
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal
.backlogit/review/
.backlogit/runtime/
.backlogit/.locks/
.backlogit/.telemetry-checkpoint.json
.backlogit/logs/

# Directories
bin/
logs/
.vscode/
.copilot/
.github/copilot/settings.local.json

# Runtime state (per-consumer checkpoints, not committed)
.backlogit/runtime/
.autoharness/staging/
.autoharness/backups/
*.exe~
prompt.md

# Machine-local telemetry harvest checkpoint (changes per machine/run)
.backlogit/.telemetry-checkpoint.json

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# graphtor-docs — managed by graphtor-docs install
.graphtor/

