# Example configuration for intercom-go.
#
# This file is a synthetic, loadable example — every value here is a
# placeholder for local experimentation or documentation purposes. It is
# not intended to be copied verbatim into a production deployment without
# review.
#
# default_workspace_root is set to "." so this example validates against
# the current working directory of whatever process loads it (the
# internal/config package directory when run via `go test` from
# internal/config/example_test.go, since Go sets the test process's
# working directory to the package directory) without requiring
# per-environment templating.
#
# See docs/config-reference.md for the full key reference, defaults, and
# validation rules.

default_workspace_root = "."
max_concurrent_sessions = 3
http_port = 3000
retention_days = 30
operator_detail_level = "standard"

[copilot]
cli_path = ""   # empty = resolve the Copilot CLI from PATH / COPILOT_CLI_PATH

[commands]
review = "review the changes and report findings"

[timeouts]
approval_seconds = 3600
prompt_seconds = 1800
wait_seconds = 0

[stall]
enabled = true
inactivity_threshold_seconds = 300
escalation_threshold_seconds = 120
max_retries = 3
default_nudge_message = "Continue working on the current task. Pick up where you left off."

[database]
path = "data/agent-rc.db"

[[workspace]]
workspace_id = "example-workspace"
label = "Example workspace"
path = "."
