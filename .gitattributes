# autoharness-managed artifacts: pin LF so manifest checksums stay reproducible
# across checkouts regardless of core.autocrlf. Do not change without re-running
# `autoharness verify-workspace`.
.github/** text eol=lf
AGENTS.md text eol=lf
.markdownlint.json text eol=lf
start.ps1 text eol=lf
start.sh text eol=lf
scripts/** text eol=lf
.autoharness/** text eol=lf
docs/compound/** text eol=lf
docs/plans/** text eol=lf
docs/decisions/** text eol=lf
docs/memory/** text eol=lf
docs/closure/** text eol=lf

# Go sources and workflow-adjacent config: force LF so gofmt/CI gates stay
# stable regardless of core.autocrlf on Windows checkouts (001.001.002-ST).
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
.golangci.yml text eol=lf
